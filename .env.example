# Plantilla de variables de entorno del proyecto.
# Copia este archivo a .env (cp .env.example .env) y ajusta los valores.
# El archivo .env no se sube a Git; este sí, y no debe llevar secretos.
# Si agregas un os.getenv() al código, agrega aquí la variable.

# URI del servidor de tracking de MLflow (lo lee mi_bici/config.py).
# Requiere el servidor levantado:
#   mlflow server --backend-store-uri sqlite:///mlflow.db --host 127.0.0.1 --port 5000
# Si la comentas o la borras, el código escribe directo en sqlite:///<raíz>/mlflow.db.
# En macOS, si usas otro puerto por AirPlay (p. ej. 5001), cámbialo aquí también.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
